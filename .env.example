# Copy to .env to override the dev defaults baked into docker-compose.yml.
# Everything below matches the shipped dev defaults — change all of it
# before any real deployment (e.g. JWT_SECRET: openssl rand -hex 32).

# MySQL (used by the db service and the api service credentials)
MYSQL_ROOT_PASSWORD=root-dev-insecure
MYSQL_PASSWORD=ApiPass_2026!

# API runtime
DB_PASS=ApiPass_2026!
JWT_SECRET=dev-only-insecure-secret-change-me
